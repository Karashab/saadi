{$NOOR_HOST} {
	# TLS_MODE=internal: Caddy's own certificate authority (install its root on users' machines).
	# TLS_MODE=/certs/noor.crt /certs/noor.key: your organization's certificate.
	tls {$TLS_MODE}
	encode zstd gzip
	request_body {
		max_size 520MB
	}
	handle /auth/* {
		reverse_proxy keycloak:8080
	}
	handle {
		reverse_proxy app:8080
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
}

http://{$NOOR_HOST} {
	redir https://{host}{uri} permanent
}
